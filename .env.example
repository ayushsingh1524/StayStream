# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=booking-events

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=staystream
DB_USER=stream
DB_PASSWORD=stream_dev_pw

# ── Streaming Tuning ─────────────────────────────────────────────────────────
WATERMARK=2 minutes
WINDOW=1 minute
TRIGGER_INTERVAL=5 seconds
SHUFFLE_PARTITIONS=4
CHECKPOINT_DIR=./checkpoints/metrics
SPARK_METRICS_FILE=/tmp/staystream_spark_metrics.json

# ── Anomaly Detection ────────────────────────────────────────────────────────
ALERT_CANCEL_RATE_THRESHOLD=0.25
ALERT_COOLDOWN_MINUTES=5

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8000
